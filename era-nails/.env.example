# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Admin — emails con acceso al panel /admin (separados por coma)
# Ejemplo con uno: joseverdun1@gmail.com
# Ejemplo con varios: joseverdun1@gmail.com,otra@gmail.com
ADMIN_EMAILS=

# Cron — protege el endpoint /api/cron/reminders (Vercel lo envía automáticamente)
# Generar con: openssl rand -hex 32
CRON_SECRET=

# YCloud — WhatsApp Business API
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_NUMBER=
