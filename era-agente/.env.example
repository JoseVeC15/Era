# OpenAI
OPENAI_API_KEY=

# YCloud — WhatsApp Business API
YCLOUD_API_KEY=
YCLOUD_WHATSAPP_NUMBER=

# YCloud Webhook Secret — cadena aleatoria (ej. openssl rand -hex 32)
# Configurar el mismo valor en el dashboard de YCloud como token de verificación
# NO usar una URL aquí — debe ser un string secreto aleatorio
YCLOUD_WEBHOOK_SECRET=

# Supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Número de la dueña con código de país (sin +), ej: 595984704144
OWNER_PHONE=
